<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning">
                <h4 class="mb-0">Edit Question</h4>
            </div>
            <div class="card-body">
                <form action="/questions/<%= question._id %>?_method=PUT" method="POST">
                    <div class="mb-3">
                        <label for="text" class="form-label">Question Text</label>
                        <input type="text" class="form-control" id="text" name="text" value="<%= question.text %>"
                            required>
                    </div>

                    <div class="row">
                        <% question.options.forEach((opt, idx)=> { %>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Option <%= idx + 1 %></label>
                                <input type="text" class="form-control" name="options[]" value="<%= opt %>" required>
                            </div>
                            <% }) %>
                    </div>

                    <div class="mb-3">
                        <label for="correctAnswerIndex" class="form-label">Correct Option</label>
                        <select class="form-select" id="correctAnswerIndex" name="correctAnswerIndex" required>
                            <% for (let i = 0; i < 4; i++) { %>
                                <option value="<%= i %>" <%= Number(question.correctAnswerIndex) === i ? 'selected' : '' %>>Option <%= i + 1 %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/questions" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4 text-dark">Update Question</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
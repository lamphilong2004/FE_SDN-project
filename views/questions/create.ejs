<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    <%= quizId ? 'Add Question to Quiz' : 'Create New Question' %>
                </h4>
            </div>
            <div class="card-body">
                <form action="/questions" method="POST">
                    <% if (quizId) { %>
                        <input type="hidden" name="quizId" value="<%= quizId %>">
                        <div class="alert alert-info py-2">
                            Adding question to selected quiz.
                        </div>
                        <% } else if (quizzes && quizzes.length> 0) { %>
                            <div class="mb-3">
                                <label for="quizId" class="form-label">Assign to Quiz (Optional)</label>
                                <select class="form-select" id="quizId" name="quizId">
                                    <option value="">-- No Quiz (Independent Question) --</option>
                                    <% quizzes.forEach(quiz=> { %>
                                        <option value="<%= quiz._id %>">
                                            <%= quiz.title %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>
                            <% } %>

                                <div class="mb-3">
                                    <label for="text" class="form-label">Question Text</label>
                                    <input type="text" class="form-control" id="text" name="text" required
                                        placeholder="What is the capital of...">
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Option 1</label>
                                        <input type="text" class="form-control" name="options[]" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Option 2</label>
                                        <input type="text" class="form-control" name="options[]" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Option 3</label>
                                        <input type="text" class="form-control" name="options[]" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Option 4</label>
                                        <input type="text" class="form-control" name="options[]" required>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="correctAnswerIndex" class="form-label">Correct Option</label>
                                    <select class="form-select" id="correctAnswerIndex" name="correctAnswerIndex" required>
                                        <option value="" disabled selected>-- Choose the correct option --</option>
                                        <option value="0">Option 1</option>
                                        <option value="1">Option 2</option>
                                        <option value="2">Option 3</option>
                                        <option value="3">Option 4</option>
                                    </select>
                                    <div class="form-text">The API uses a 0-based index for the correct answer.</div>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <a href="<%= quizId ? '/quizzes/' + quizId : '/questions' %>"
                                        class="btn btn-outline-secondary">Cancel</a>
                                    <button type="submit" class="btn btn-primary px-4">Save Question</button>
                                </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>All Questions</h1>
    <a href="/questions/create" class="btn btn-primary">Create New Question</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Question Text</th>
                    <th>Options</th>
                    <th>Answer</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% questions.forEach(q=> { %>
                    <% const opts = Array.isArray(q.options) ? q.options : []; %>
                    <tr>
                        <td>
                            <%= q.text %>
                        </td>
                        <td>
                            <small class="text-muted">
                                <%= opts.join(', ') %></small>
                        </td>
                        <td>
                            <span class="badge bg-success">
                                <%= opts[Number(q.correctAnswerIndex)] || '' %>
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a href="/questions/<%= q._id %>/edit" class="btn btn-sm btn-outline-warning">Edit</a>
                                <form action="/questions/<%= q._id %>?_method=DELETE" method="POST" class="d-inline"
                                    onsubmit="return confirm('Delete this question?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
        <% if (questions.length===0) { %>
            <tr>
                <td colspan="4" class="text-center text-muted">No questions found.</td>
            </tr>
            <% } %>
                </tbody>
                </table>
</div>
</div>
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Create New Quiz</h4>
            </div>
            <div class="card-body">
                <form action="/quizzes" method="POST">
                    <div class="mb-3">
                        <label for="title" class="form-label">Quiz Title</label>
                        <input type="text" class="form-control" id="title" name="title" required
                            placeholder="e.g., General Knowledge">
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="description" rows="3" 
                            placeholder="Describe what this quiz covers..."></textarea>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a href="/quizzes" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Create Quiz</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="mb-4">
    <a href="/quizzes/<%= quiz._id %>" class="btn btn-link p-0 text-decoration-none">&larr; Back to Quiz</a>
    <h1 class="mt-2">Add Existing Questions</h1>
    <p class="text-muted mb-0">Select questions from the global pool and attach them to this quiz.</p>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div>
            <div class="fw-semibold"><%= quiz.title || 'Quiz' %></div>
            <div class="small text-muted">Quiz ID: <%= quiz._id %></div>
        </div>
    </div>

    <div class="card-body">
        <form action="/quizzes/<%= quiz._id %>/attach-questions" method="POST">
            <% if (questions && questions.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 44px;"></th>
                                <th>Question</th>
                                <th class="text-muted">Quiz</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% questions.forEach((q) => { %>
                                <tr>
                                    <td>
                                        <% const isChecked = selectedIds && (selectedIds.has(q._id)); %>
                                        <input class="form-check-input" type="checkbox" name="questionIds" value="<%= q._id %>" <%= isChecked ? 'checked' : '' %>>
                                    </td>
                                    <td>
                                        <div class="fw-semibold"><%= q.text %></div>
                                        <div class="small text-muted"><%= (q.options || []).join(', ') %></div>
                                    </td>
                                    <td class="small text-muted"><%= q.quiz || '—' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between">
                    <a class="btn btn-outline-secondary" href="/quizzes/<%= quiz._id %>">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Selection</button>
                </div>
            <% } else { %>
                <div class="text-center text-muted">No questions available.</div>
                <div class="mt-3 text-center">
                    <a class="btn btn-outline-primary" href="/questions/create">Create a Question</a>
                </div>
            <% } %>
        </form>
    </div>
</div>

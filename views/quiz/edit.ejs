<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning">
                <h4 class="mb-0">Edit Quiz</h4>
            </div>
            <div class="card-body">
                <form action="/quizzes/<%= quiz._id %>?_method=PUT" method="POST">
                    <div class="mb-3">
                        <label for="title" class="form-label">Quiz Title</label>
                        <input type="text" class="form-control" id="title" name="title" value="<%= quiz.title %>"
                            required>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="description"
                            rows="3"><%= quiz.description %></textarea>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a href="/quizzes" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4 text-dark">Update Quiz</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>